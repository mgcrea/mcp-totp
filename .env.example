# ── Credentials ──────────────────────────────────────────────────────────────
# TODO: describe where these come from, with the console URL that creates them.
TOTP_CLIENT_ID=
TOTP_CLIENT_SECRET=

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to register the WRITE tools. Off by default: with the flag unset the
# mutating tools are not merely refused, they are never registered, so an agent
# cannot call them at all. Destructive tools additionally require confirm: true.
TOTP_ALLOW_WRITES=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Override the API base URL entirely (a proxy, or a staging host).
TOTP_API_URL=

# Retry budget for 401 / 429 / 5xx responses. Defaults to 3.
TOTP_MAX_RETRIES=3

# Set to 1 to log debug output to stderr.
TOTP_DEBUG=
